# --- MAX ---
MAX_BOT_TOKEN=put-your-token-here
MAX_BOT_USERNAME=t459_hakaton_max_bot
MAX_API_BASE=https://botapi.max.ru
# Публичный https-адрес, по которому МАХ открывает мини-приложение.
# Для локальной отладки — туннель (ngrok/cloudpub), в проде — домен контура.
PUBLIC_WEBAPP_URL=https://example.com

# strict  — пускать только запросы с валидной подписью initData (прод)
# lenient — пускать без подписи, но помечать сессию как неподтверждённую (пилот)
# dev     — подпись не проверяется совсем (локальная разработка)
AUTH_MODE=dev
SESSION_TTL_HOURS=24

# --- Источник данных ---
# demo — встроенный датасет, odata — реальная база 1С
DATA_SOURCE=demo
# Какой файл читает демо-источник:
#   data/demo_1c.json       — маленький набор на 6 рейсов, для проверки формул
#   data/demo_1c_large.json — год работы парка, генерируется tools/generate_dataset.py
DEMO_DATA_FILE=data/demo_1c.json
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=
# Имя файла маппинга полей конкретной конфигурации 1С (backend/adapters/mappings/)
ONEC_MAPPING=ut_11

# --- ЭДО ---
# demo — встроенные статусы, diadoc/astral/kontur — реальный оператор
EDO_PROVIDER=demo
EDO_API_BASE=
EDO_API_KEY=

# --- Маршрутизация ---
# demo — встроенный движок, yandex — Яндекс.Маршрутизация
ROUTING_ENGINE=demo
YANDEX_ROUTING_API_KEY=

# --- Прочее ---
ENABLE_BOT=1
HOST=127.0.0.1
PORT=8099
DB_PATH=data/app.sqlite3
