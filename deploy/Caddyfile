# HTTPS-вход для мини-приложения. Caddy сам получает и продлевает сертификат
# Let's Encrypt для адреса из переменной DOMAIN.
#
# Свой домен не обязателен: подойдёт бесплатный адрес вида 203-0-113-5.sslip.io,
# который резолвится в IP сервера 203.0.113.5.

{$DOMAIN} {
	encode gzip
	reverse_proxy app:8099
}
