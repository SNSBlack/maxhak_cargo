  "components": {
    "schemas": {
      "CostRequest": {
        "properties": {
          "distance_km": {
            "type": "number",
            "maximum": 20000.0,
            "exclusiveMinimum": 0.0,
            "title": "Distance Km"
          },
          "days": {
            "type": "number",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Days",
            "default": 1
          },
          "vehicle_id": {
            "type": "string",
            "title": "Vehicle Id"
          },
          "driver_id": {
            "type": "string",
            "title": "Driver Id"
          },
          "federal_share": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Federal Share",
            "default": 0.9
          },
          "toll_road_rub": {
            "type": "number",
            "minimum": 0.0,
            "title": "Toll Road Rub",
            "default": 0
          },
          "cargo_value_rub": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cargo Value Rub",
            "default": 0
          },
          "edo_docs_count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Edo Docs Count",
            "default": 2
          },
          "revenue_rub": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Revenue Rub"
          },
          "trip_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trip Date"
          }
        },
        "type": "object",
        "required": [
          "distance_km",
          "vehicle_id",
          "driver_id"
        ],
        "title": "CostRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "meta",
      "description": "Служебные методы: кто открыл приложение, на каких источниках оно работает."
    },
    {
      "name": "trips",
      "description": "Рейсы, справочники и калькулятор себестоимости с разбивкой по статьям."
    },
    {
      "name": "edo",
      "description": "ЭДО-комплаенс: чек-лист готовности компании и статусы документов."
    },
    {
      "name": "routes",
      "description": "Сравнение вариантов маршрута по деньгам с объяснением разницы."
    },
    {
      "name": "tracking",
      "description": "Клиентский трекинг груза: стадия, срок прибытия, ставка."
    }
  ]
}